
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id                String  @id @default(cuid())
  name              String
  sku               String  @unique
  quantity          Int
  price             Decimal
  costPrice         Decimal?
  supplier          String?
  description       String?
  imageUrl          String?
  tags              String? // JSON string for tags: ["tag1", "tag2"]
  lowStockThreshold Int?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  role       String   // "ADMIN", "MANAGER", "STAFF"
  avatarUrl  String?
  isActive   Boolean  @default(true)
  lastLogin  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdPOs PurchaseOrder[] @relation("CreatedBy")
  sales      Sale[]
}

model PurchaseOrder {
  id                   String   @id @default(cuid())
  poNumber             String   @unique
  supplierName         String
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  status               String   // "Draft", "Ordered", "Shipped", "Received", "Cancelled"
  
  items PurchaseOrderItem[]

  discountAmount Float?
  shippingCost   Float?
  taxes          Float?
  totalAmount    Float

  notes String?

  createdById String
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict) // Restrict deletion of product if it's in a PO item
  productName     String   // Denormalized for historical record if product name changes
  
  quantityOrdered  Int
  quantityReceived Int?
  unitCost         Decimal
  totalCost        Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id                 String    @id @default("main_settings") // Singleton ID
  appName            String    @default("StockPilot HQ")
  dateFormat         String    @default("yyyy-MM-dd")
  timeZone           String    @default("Europe/London")
  defaultCurrency    String    @default("GBP")
  emailNotifications Boolean   @default(true)
  lowStockAlerts     Boolean   @default(true)
  newOrderAlerts     Boolean   @default(true)
  defaultTaxRate     Float     @default(0) // e.g., 10 for 10%
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Sale {
  id             String   @id @default(cuid())
  saleNumber     String   @unique
  saleDate       DateTime @default(now())
  
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerName   String? // Denormalized customer name for quick display / if customer is deleted

  userId         String // Cashier/User who made the sale
  user           User     @relation(fields: [userId], references: [id])
  
  items          SaleItem[]
  
  subtotal       Decimal
  discountAmount Decimal  @default(0)
  taxPercent     Decimal  @default(0) // e.g., 10 for 10%
  taxAmount      Decimal  @default(0)
  shippingCost   Decimal  @default(0)
  grandTotal     Decimal

  paymentMethod  String?  // e.g., "Cash", "Credit Card", "VISA-1234"
  status         String   @default("Completed") // e.g., "Completed", "PendingPayment", "Refunded", "Cancelled"
  
  notes          String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict) // Prevent product deletion if sold
  productName String // Denormalized product name at time of sale
  
  quantity  Int
  unitPrice Decimal // Price of the product at the time of sale
  totalPrice Decimal // quantity * unitPrice

  costPriceAtSale Decimal? // Cost price of the product at the time of sale for P/L

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
