datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String? // Keep for Credentials provider
  image         String?   @map("avatarUrl") // Map to existing avatarUrl if needed
  role          String    @default("STAFF") // Keep our custom role, can be ADMIN, STAFF, MANAGER
  isActive      Boolean   @default(true)
  lastLogin     DateTime?

  accounts      Account[]
  sessions      Session[]
  createdPOs    PurchaseOrder[] @relation("CreatedByUser")
  sales         Sale[]
  stockMovements StockMovement[]
  posSessions   PosSession[]
  cashTransactions CashTransaction[]
  expenses      Expense[] // User who recorded the expense

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NextAuth specific models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
// End NextAuth specific models


model AppSettings {
  id                String    @id @default("main_settings")
  appName           String    @default("StockPilot")
  dateFormat        String    @default("MM/dd/yyyy") // e.g., "MM/dd/yyyy", "dd/MM/yyyy", "yyyy-MM-dd"
  timeZone          String    @default("America/New_York")
  defaultCurrency   String    @default("USD")
  emailNotifications Boolean  @default(true)
  lowStockAlerts    Boolean   @default(true)
  newOrderAlerts    Boolean   @default(false) // e.g., for new Purchase Orders
  defaultTaxRate    Decimal   @default(0) // Default sales tax rate as a percentage (e.g., 7.5 for 7.5%)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}


model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                String    @id @default(cuid())
  name              String
  sku               String    @unique
  quantity          Int       @default(0)
  price             Decimal   @default(0)
  costPrice         Decimal?
  supplier          String?
  description       String?
  imageUrl          String?
  tags              Json?     // Store as JSON array of strings: ["tag1", "tag2"]
  lowStockThreshold Int?      @default(10)

  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  purchaseOrderItems PurchaseOrderItem[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrder {
  id                    String    @id @default(cuid())
  poNumber              String    @unique
  supplierName          String
  orderDate             DateTime
  expectedDeliveryDate  DateTime?
  status                String
  items                 PurchaseOrderItem[]

  discountAmount        Decimal?  @default(0)
  shippingCost          Decimal?  @default(0)
  taxes                 Decimal?  @default(0)
  totalAmount           Decimal   @default(0)
  notes                 String?

  createdById           String
  createdBy             User      @relation("CreatedByUser", fields: [createdById], references: [id])

  stockMovements        StockMovement[] @relation("PurchaseOrderToStockMovement") // Tambahkan relasi balik

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model PurchaseOrderItem {
  id                String    @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  productName       String    // Denormalized for easier display on PO
  quantityOrdered   Int
  quantityReceived  Int?
  unitCost          Decimal
  totalCost         Decimal   // quantityOrdered * unitCost

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String?   @unique
  phone     String?
  address   String?
  notes     String?
  sales     Sale[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Sale {
  id                String    @id @default(cuid())
  saleNumber        String    @unique
  saleDate          DateTime
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String?
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  items             SaleItem[]

  subtotal          Decimal   @default(0)
  discountAmount    Decimal   @default(0)
  taxPercent        Decimal   @default(0)
  taxAmount         Decimal   @default(0)
  shippingCost      Decimal   @default(0)
  grandTotal        Decimal   @default(0)

  paymentMethod     String?
  status            String
  notes             String?

  cashTransactionId String? @unique
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull)

  stockMovements    StockMovement[] @relation("SaleToStockMovement") // Tambahkan nama relasi

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}


model SaleItem {
  id              String    @id @default(cuid())
  saleId          String
  sale            Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id]) // Keep relation for product details
  productName     String    // Denormalized name at time of sale
  quantity        Int
  unitPrice       Decimal   // Price per unit at time of sale
  totalPrice      Decimal   // quantity * unitPrice
  costPriceAtSale Decimal?  // Cost price of the product at the time of sale for COGS calculation

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}


enum StockMovementType {
  INITIAL_STOCK
  SALE
  PURCHASE_RECEIPT
  RETURN_CUSTOMER // Added for customer returns
  RETURN_SUPPLIER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model StockMovement {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type            StockMovementType
  quantityChange  Int
  quantityBefore  Int
  quantityAfter   Int
  reason          String?
  referenceId     String?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relasi ke PurchaseOrder
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation("PurchaseOrderToStockMovement", fields: [purchaseOrderId], references: [id])

  // Relasi ke Sale
  saleId          String?
  sale            Sale? @relation("SaleToStockMovement", fields: [saleId], references: [id])

  createdAt       DateTime  @default(now())
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

model PosSession {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id])
  startTime             DateTime
  endTime               DateTime?
  status                PosSessionStatus @default(OPEN)

  startingCash          Decimal   @default(0)
  countedCash           Decimal?  // Actual cash counted at end of session
  expectedCashInDrawer  Decimal   @default(0) // Calculated: startingCash + cashSales - cashRefunds + payIns - payOuts

  totalSalesAmount      Decimal   @default(0) // Sum of all cash sales during this session
  totalRefundsAmount    Decimal   @default(0) // Sum of all cash refunds during this session
  // payIns and payOuts could be tracked via CashTransactions

  notes                 String?
  cashTransactions      CashTransaction[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

enum CashTransactionType {
  STARTING_CASH     // Initial cash at the start of a POS session
  SALE_CASH         // Cash received from a sale
  REFUND_CASH       // Cash given out for a refund
  PAY_IN            // Cash added to the drawer (e.g., float addition)
  PAY_OUT           // Cash removed from the drawer (e.g., bank deposit, expense payment)
  ENDING_CASH       // Implicitly, the counted cash at session end (not a separate transaction type usually)
}

model CashTransaction {
  id              String    @id @default(cuid())
  posSessionId    String
  posSession      PosSession @relation(fields: [posSessionId], references: [id], onDelete: Cascade)
  userId          String    // User performing/responsible for the transaction
  user            User      @relation(fields: [userId], references: [id])
  type            CashTransactionType
  amount          Decimal   // Positive for cash in, negative for cash out (or always positive, type dictates direction)
  description     String?   // e.g., "Sale #S123", "Float top-up"
  sale            Sale?     // Optional: Link to the sale if this transaction is for a sale

  createdAt       DateTime  @default(now())
}


model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Expense {
  id                  String    @id @default(cuid())
  date                DateTime  // Date the expense was incurred
  description         String
  amount              Decimal
  expenseCategoryId   String
  category            ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  userId              String    // User who recorded the expense
  user                User      @relation(fields: [userId], references: [id])
  notes               String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}