// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                String    @id @default(cuid())
  name              String
  sku               String    @unique
  category          String
  quantity          Int
  price             Float
  costPrice         Float?
  supplier          String?
  description       String?
  imageUrl          String?
  tags              String? // Storing as JSON string for SQLite compatibility
  lowStockThreshold Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
