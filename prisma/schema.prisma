
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // Hash this in a real app!
  role      String   // e.g., ADMIN, MANAGER, STAFF
  avatarUrl String?
  isActive  Boolean  @default(true)
  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders  PurchaseOrder[] @relation("CreatedBy")
  sales           Sale[]
  stockMovements  StockMovement[]

  @@index([email])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                String   @id @default(cuid())
  name              String
  sku               String   @unique
  quantity          Int      @default(0)
  price             Decimal
  costPrice         Decimal?
  supplier          String?
  description       String?
  imageUrl          String?
  tags              String? // JSON string for tags: ["tag1", "tag2"]
  lowStockThreshold Int?     @default(10)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]
  stockMovements     StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([sku])
}

model PurchaseOrder {
  id        String   @id @default(cuid())
  poNumber  String   @unique
  supplierName String
  orderDate DateTime
  expectedDeliveryDate DateTime?
  status    String   // e.g., Draft, Ordered, Received, Cancelled
  items     PurchaseOrderItem[]

  discountAmount Decimal? @default(0)
  shippingCost   Decimal? @default(0)
  taxes          Decimal? @default(0)
  totalAmount    Decimal  // Calculated: subtotal - discount + shipping + taxes

  notes     String?

  createdById String
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])

  stockMovements StockMovement[] // If PO receipt directly creates movements

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([poNumber])
  @@index([status])
}

model PurchaseOrderItem {
  id        String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id])
  productName String // Denormalized for easy display on PO
  quantityOrdered Int
  quantityReceived Int?
  unitCost  Decimal
  totalCost Decimal // Calculated: quantityOrdered * unitCost

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

model Customer {
  id    String @id @default(cuid())
  name  String
  email String? @unique
  phone String?
  // address String? // Consider a separate Address model if complex

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([name])
}

model Sale {
  id           String @id @default(cuid())
  saleNumber   String @unique
  saleDate     DateTime @default(now())

  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String // Denormalized, especially if customer is guest or details change

  userId       String // ID of the staff/user who made the sale
  user         User     @relation(fields: [userId], references: [id])

  items        SaleItem[]

  subtotal       Decimal
  discountAmount Decimal  @default(0)
  taxPercent     Decimal  @default(0) // Store as percentage, e.g., 7.5 for 7.5%
  taxAmount      Decimal  // Calculated: (subtotal - discountAmount) * taxPercent / 100
  shippingCost   Decimal  @default(0)
  grandTotal     Decimal  // Calculated: subtotal - discountAmount + taxAmount + shippingCost

  paymentMethod String? // e.g., Cash, Credit Card, VISA
  status        String   // e.g., PendingPayment, Completed, Refunded, Cancelled
  notes         String?

  stockMovements StockMovement[] // If sale directly creates movements

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([saleNumber])
  @@index([status])
  @@index([customerId])
  @@index([userId])
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  sale      Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])
  productName String // Denormalized
  quantity  Int
  unitPrice Decimal
  totalPrice Decimal // Calculated: quantity * unitPrice
  costPriceAtSale Decimal? // Cost price of the product at the time of sale for profit calculation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}


model AppSettings {
  id                 String    @id @default("main_settings")
  appName            String    @default("StockPilot")
  dateFormat         String    @default("MM/dd/yyyy")
  timeZone           String    @default("America/New_York")
  defaultCurrency    String    @default("USD")
  emailNotifications Boolean   @default(true)
  lowStockAlerts     Boolean   @default(true)
  newOrderAlerts     Boolean   @default(false)
  defaultTaxRate     Decimal   @default(0) // e.g., 7.5 for 7.5%
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

enum StockMovementType {
  INITIAL_STOCK
  SALE
  PURCHASE_RECEIPT
  RETURN_CUSTOMER // Added for customer returns
  RETURN_SUPPLIER // For returning goods to supplier
  ADJUSTMENT_IN   // Manual stock increase
  ADJUSTMENT_OUT  // Manual stock decrease (shrinkage, damage)
  TRANSFER_IN     // Stock transfer between locations (if multi-location)
  TRANSFER_OUT    // Stock transfer between locations (if multi-location)
}

model StockMovement {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  type           StockMovementType
  quantityChange Int      // Positive for increase, negative for decrease
  quantityBefore Int      // Stock quantity before this movement
  quantityAfter  Int      // Stock quantity after this movement
  reason         String?  // e.g., "Sale #S1001", "PO #PO005 Received", "Stock Adjustment - Damaged"
  referenceId    String?  // ID of related Sale, PO, Adjustment record, etc.
  
  userId         String?  // ID of the user who initiated/caused the movement (optional)
  user           User?    @relation(fields: [userId], references: [id])

  createdAt      DateTime @default(now())

  @@index([productId])
  @@index([type])
  @@index([referenceId])
}
