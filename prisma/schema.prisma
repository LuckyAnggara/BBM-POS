
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id                String  @id @default(cuid())
  name              String
  sku               String  @unique
  category          String
  quantity          Int
  price             Float
  costPrice         Float?
  supplier          String?
  description       String?
  imageUrl          String?
  tags              String? // Stored as JSON string: ["tag1", "tag2"]
  lowStockThreshold Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]
}

model User {
  id        String  @id @default(cuid())
  name      String
  email     String  @unique
  role      String // "ADMIN", "MANAGER", "STAFF"
  avatarUrl String?
  isActive  Boolean @default(true)
  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  sales          Sale[]
}

model PurchaseOrder {
  id                    String   @id @default(cuid())
  poNumber              String   @unique
  supplierName          String
  orderDate             DateTime
  expectedDeliveryDate  DateTime?
  status                String // e.g., "Draft", "Ordered", "Received", "Cancelled"
  items                 PurchaseOrderItem[]
  discountAmount        Float?   @default(0)
  shippingCost          Float?   @default(0)
  taxes                 Float?   @default(0) // Could be amount or percentage based on convention
  totalAmount           Float
  notes                 String?
  createdById           String
  createdBy             User     @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderItem {
  id                String   @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  productName       String // Denormalized for easier display on PO
  quantityOrdered   Int
  quantityReceived  Int?
  unitCost          Float
  totalCost         Float    // quantityOrdered * unitCost

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id                 String   @id @default("main_settings") // Ensure only one record
  appName            String   @default("StockPilot")
  dateFormat         String   @default("MM/dd/yyyy")
  timeZone           String   @default("America/New_York")
  defaultCurrency    String   @default("USD")
  emailNotifications Boolean  @default(true)
  lowStockAlerts     Boolean  @default(true)
  newOrderAlerts     Boolean  @default(false)
  defaultTaxRate     Float    @default(0) // e.g., 10 for 10%

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id    String @id @default(cuid())
  name  String
  email String? @unique
  phone String?

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id             String   @id @default(cuid())
  saleNumber     String   @unique
  saleDate       DateTime
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerName   String? // Denormalized if customer is not registered or for quick display
  userId         String   // Cashier/User who made the sale
  user           User     @relation(fields: [userId], references: [id])
  items          SaleItem[]
  subtotal       Float
  discountAmount Float    @default(0)
  taxPercent     Float    @default(0) // The tax percentage applied at the time of sale
  taxAmount      Float    @default(0) // Calculated tax amount
  shippingCost   Float    @default(0)
  grandTotal     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleItem {
  id         String @id @default(cuid())
  saleId     String
  sale       Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  productName String // Denormalized product name at time of sale
  quantity   Int
  unitPrice  Float  // Price of product at time of sale
  totalPrice Float  // quantity * unitPrice

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
