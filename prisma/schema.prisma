
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id                String    @id @default(cuid())
  name              String
  sku               String    @unique
  description       String?
  price             Decimal   @default(0)
  costPrice         Decimal?
  quantity          Int       @default(0)
  lowStockThreshold Int?      @default(10)
  imageUrl          String?
  tags              Json?     // Store as JSON array: ["tag1", "tag2"]
  supplier          String?
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])

  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]
  stockMovements     StockMovement[]   @relation("ProductStockMovements")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([categoryId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  password           String?   // Added password field
  role               String    @default("STAFF") // e.g., ADMIN, MANAGER, STAFF
  isActive           Boolean   @default(true)
  lastLogin          DateTime?
  image              String?   // URL to user's avatar/image
  avatarUrl          String?   // Compatibility if used elsewhere

  sales              Sale[]
  purchaseOrders     PurchaseOrder[] @relation("UserPurchaseOrders")
  stockMovements     StockMovement[] @relation("UserStockMovements")
  posSessions        PosSession[]    @relation("UserPosSessions")
  cashTransactions   CashTransaction[] @relation("UserCashTransactions")
  expenses           Expense[]       @relation("UserExpenses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String?   @unique
  phone     String?
  address   String?
  notes     String?
  sales     Sale[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Sale {
  id              String    @id @default(cuid())
  saleNumber      String    @unique // e.g., S20240715-001
  saleDate        DateTime  @default(now())
  customerId      String?
  customerName    String? // Denormalized for easy display
  userId          String?   // ID of the User (cashier) who made the sale
  subtotal        Decimal
  discountAmount  Decimal   @default(0)
  taxPercent      Decimal   @default(0) // Store as percentage e.g., 7.5 for 7.5%
  taxAmount       Decimal   @default(0)
  shippingCost    Decimal   @default(0)
  grandTotal      Decimal
  paymentMethod   String?   // e.g., Cash, Credit Card, Transfer
  status          String    @default("Completed") // e.g., PendingPayment, Completed, Refunded, Cancelled
  notes           String?

  items           SaleItem[]
  customer        Customer? @relation(fields: [customerId], references: [id])
  user            User?     @relation(fields: [userId], references: [id])
  cashTransaction CashTransaction? @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cashTransactionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleDate])
  @@index([customerId])
  @@index([userId])
  @@index([status])
}

model SaleItem {
  id              String    @id @default(cuid())
  saleId          String
  productId       String
  productName     String    // Denormalized
  quantity        Int
  unitPrice       Decimal   // Price at the time of sale
  totalPrice      Decimal   // quantity * unitPrice
  costPriceAtSale Decimal?  // Cost price at the time of sale for COGS calculation

  sale            Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product?  @relation(fields: [productId], references: [id], onDelete: Restrict) // Prevent product deletion if in sale

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}


model PurchaseOrder {
  id                   String    @id @default(cuid())
  poNumber             String    @unique // e.g., PO2024-001
  supplierName         String
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?
  status               String    @default("Draft") // e.g., Draft, Ordered, Shipped, Received, Cancelled
  discountAmount       Decimal?  @default(0)
  shippingCost         Decimal?  @default(0)
  taxes                Decimal?  @default(0)
  totalAmount          Decimal   // Calculated: (sum of item totals) - discount + shipping + taxes
  notes                String?
  createdById          String?   // ID of the User who created the PO
  
  items                PurchaseOrderItem[]
  createdBy            User?               @relation("UserPurchaseOrders", fields: [createdById], references: [id])
  stockMovements       StockMovement[]     @relation("PurchaseOrderStockMovements")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([poNumber])
  @@index([supplierName])
  @@index([status])
  @@index([createdById])
}

model PurchaseOrderItem {
  id                String   @id @default(cuid())
  purchaseOrderId   String
  productId         String
  productName       String   // Denormalized
  quantityOrdered   Int
  quantityReceived  Int?     @default(0)
  unitCost          Decimal
  totalCost         Decimal  // quantityOrdered * unitCost

  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [productId], references: [id], onDelete: Restrict) // Prevent product deletion if in PO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

enum StockMovementType {
  INITIAL_STOCK
  SALE
  PURCHASE_RECEIPT
  RETURN_CUSTOMER
  RETURN_SUPPLIER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  type           StockMovementType // e.g., SALE, PURCHASE_RECEIPT, ADJUSTMENT_IN, ADJUSTMENT_OUT
  quantityChange Int               // Positive for increase, negative for decrease
  quantityBefore Int               // Stock quantity before this movement
  quantityAfter  Int               // Stock quantity after this movement
  reason         String?           // e.g., "Stock take adjustment", "Damaged goods"
  referenceId    String?           // e.g., Sale ID, Purchase Order ID, Adjustment ID
  userId         String?           // User who performed/triggered the movement
  
  product        Product?          @relation("ProductStockMovements", fields: [productId], references: [id], onDelete: Cascade)
  user           User?             @relation("UserStockMovements", fields: [userId], references: [id])
  purchaseOrder  PurchaseOrder?    @relation("PurchaseOrderStockMovements", fields: [referenceId], references: [id])


  createdAt DateTime @default(now())

  @@index([productId])
  @@index([type])
  @@index([referenceId])
  @@index([userId])
}

model AppSettings {
  id                 String    @id @default("main_settings")
  appName            String    @default("StockPilot")
  dateFormat         String    @default("MM/dd/yyyy") // e.g., "MM/dd/yyyy", "dd/MM/yyyy"
  timeZone           String    @default("America/New_York") // e.g., "America/New_York", "Europe/London"
  defaultCurrency    String    @default("USD") // Currency Code: "USD", "IDR"
  currencySymbol     String    @default("$")   // Symbol: "$", "Rp "
  currencySuffix     String    @default("")    // Suffix: "", ",-"
  currencyDecimalPlaces Int    @default(2)     // Number of decimal places: 2 for USD, 0 for IDR
  emailNotifications Boolean   @default(true)
  lowStockAlerts     Boolean   @default(true)
  newOrderAlerts     Boolean   @default(false)
  defaultTaxRate     Decimal   @default(7.5) // Percentage
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

model PosSession {
  id                   String           @id @default(cuid())
  userId               String
  startTime            DateTime         @default(now())
  endTime              DateTime?
  startingCash         Decimal
  countedCash          Decimal?         // Cash counted by user at end of session
  expectedCashInDrawer Decimal          // Calculated: startingCash + cash_sales - cash_refunds + pay_ins - pay_outs
  totalSalesAmount     Decimal          @default(0) // Sum of all cash sales in this session
  totalRefundsAmount   Decimal          @default(0) // Sum of all cash refunds in this session
  status               PosSessionStatus @default(OPEN)

  user                 User             @relation("UserPosSessions", fields: [userId], references: [id])
  cashTransactions     CashTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

enum CashTransactionType {
  STARTING_CASH
  SALE_CASH
  REFUND_CASH
  PAY_IN          // Cash added to drawer mid-session
  PAY_OUT         // Cash removed from drawer mid-session (e.g. for bank deposit, paying supplier)
}

model CashTransaction {
  id             String              @id @default(cuid())
  posSessionId   String
  userId         String?
  type           CashTransactionType
  amount         Decimal             // Positive for additions, negative for removals from drawer if that's how you model PAY_OUT
  description    String?
  saleId         String?             @unique // Link to Sale if this transaction is for a sale
  
  posSession     PosSession          @relation(fields: [posSessionId], references: [id])
  user           User?               @relation("UserCashTransactions", fields: [userId], references: [id])
  sale           Sale?      

  createdAt DateTime @default(now())

  @@index([posSessionId])
  @@index([userId])
  @@index([type])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Expense {
  id                  String          @id @default(cuid())
  date                DateTime
  description         String
  amount              Decimal
  expenseCategoryId   String
  userId              String?         // User who logged the expense
  notes               String?
  
  category            ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  user                User?           @relation("UserExpenses", fields: [userId], references: [id])

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([date])
  @@index([expenseCategoryId])
  @@index([userId])
}
