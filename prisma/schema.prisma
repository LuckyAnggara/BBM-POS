
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id                String  @id @default(cuid())
  name              String
  sku               String  @unique
  quantity          Int
  price             Float
  costPrice         Float?
  supplier          String?
  description       String?
  imageUrl          String?
  tags              String? // JSON string for tags: ["tag1", "tag2"]
  lowStockThreshold Int?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]

  @@index([name])
  @@index([sku])
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrder {
  id                   String    @id @default(cuid())
  poNumber             String    @unique // e.g. PO-2023-0001
  supplierName         String
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  status               String // e.g. "Draft", "Ordered", "Received", "Cancelled"
  items                PurchaseOrderItem[]
  discountAmount       Float?
  shippingCost         Float?
  taxes                Float?
  totalAmount          Float
  notes                String?
  createdById          String
  createdBy            User      @relation(fields: [createdById], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([poNumber])
  @@index([supplierName])
  @@index([status])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  productName      String // Denormalized for easier display on PO if product name changes later
  quantityOrdered  Int
  quantityReceived Int?
  unitCost         Float
  totalCost        Float
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  role          String // e.g. "ADMIN", "MANAGER", "STAFF"
  avatarUrl     String?
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
  sales         Sale[]

  @@index([email])
  @@index([role])
}

model AppSettings {
  id                 String    @id @default("main_settings") // Ensure only one settings record
  appName            String    @default("StockPilot HQ")
  dateFormat         String    @default("yyyy-MM-dd")
  timeZone           String    @default("Europe/London")
  defaultCurrency    String    @default("GBP")
  emailNotifications Boolean   @default(true)
  lowStockAlerts     Boolean   @default(true)
  newOrderAlerts     Boolean   @default(true)
  defaultTaxRate     Float     @default(10.0) // e.g., 10 for 10%
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@index([name])
  @@index([email])
}

model Sale {
  id             String     @id @default(cuid())
  saleNumber     String     @unique // Auto-generated e.g. SALE-YYYYMMDD-XXXX
  saleDate       DateTime
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  customerName   String? // Denormalized, in case customer is guest or name changes
  userId         String     // Cashier/User who made the sale
  user           User       @relation(fields: [userId], references: [id])
  subtotal       Float
  discountAmount Float?
  taxPercent     Float?     // Tax percentage at the time of sale
  taxAmount      Float?     // Calculated tax amount
  shippingCost   Float?
  grandTotal     Float
  paymentMethod  String?    // e.g. "Cash", "Card"
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  items          SaleItem[]

  @@index([saleNumber])
  @@index([customerId])
  @@index([userId])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String   // Denormalized product name at time of sale
  quantity    Int
  unitPrice   Float    // Price of product at time of sale
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}
