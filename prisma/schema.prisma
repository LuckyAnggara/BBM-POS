
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id                String  @id @default(cuid())
  name              String
  sku               String  @unique
  category          String
  quantity          Int
  price             Float
  costPrice         Float?
  supplier          String?
  description       String?
  imageUrl          String?
  tags              String? // JSON string for tags: ["organic", "fruit"]
  lowStockThreshold Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseOrderItems PurchaseOrderItem[]
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  role        String   // Changed from Role enum to String
  avatarUrl   String?
  isActive    Boolean  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[] @relation("CreatedBy")
}

model PurchaseOrder {
  id                   String   @id @default(cuid())
  poNumber             String   @unique
  supplierName         String
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  status               String   // Changed from PurchaseOrderStatus enum to String
  items                PurchaseOrderItem[]
  discountAmount       Float?
  shippingCost         Float?
  taxes                Float?
  totalAmount          Float
  notes                String?
  createdById          String
  createdBy            User     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([createdById])
}

model PurchaseOrderItem {
  id                String   @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  productName       String   // Store for historical data, in case product name changes
  quantityOrdered   Int
  quantityReceived  Int?
  unitCost          Float
  totalCost         Float    // Calculated: quantityOrdered * unitCost
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

model AppSettings {
  id                 String   @id @default("main_settings") // Use a fixed ID for the single settings record
  appName            String   @default("StockPilot")
  dateFormat         String   @default("MM/dd/yyyy")
  timeZone           String   @default("America/New_York")
  defaultCurrency    String   @default("USD")
  emailNotifications Boolean  @default(true)
  lowStockAlerts     Boolean  @default(true)
  newOrderAlerts     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
